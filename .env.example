# Copy to .env (gitignored) for docker compose and fill in. Never commit real values.
# The MySQL container reads MYSQL_*, the app reads DB_* and OIDC_*; use the same
# database password for MYSQL_PASSWORD and DB_PASSWORD.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
DB_PASSWORD=

# Sign-in: the site's cloud-stack OIDC provider (see README "Authentication").
OIDC_ISSUER=https://auth.example.com
#OIDC_BACKCHANNEL_URL=https://auth.example.com:8443
OIDC_CLIENT_ID=questionnaire
OIDC_CLIENT_SECRET=
# Public base URL of the app, used in share links.
APP_PUBLIC_URL=http://localhost:18007
